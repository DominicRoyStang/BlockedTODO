{
  "author": "Dominic Roy-Stang",
  "bugs": {
    "url": "https://github.com/DominicRoyStang/BlockedTODO/issues"
  },
  "dependencies": {
    "ajv-formats": "^2.1.1",
    "axios": "^0.27.2",
    "dotenv": "^16.0.3",
    "globby": "^13.1.1",
    "joi": "^17.6.0",
    "js-yaml": "^4.1.0",
    "knex": "^2.1.0",
    "objection": "^3.0.1",
    "objection-guid": "^3.1.0",
    "serialize-error": "^11.0.0",
    "sqlite3": "^5.1.7",
    "tempy": "^3.0.0",
    "unzipper": "^0.10.11",
    "url-regex-safe": "^3.0.0",
    "uuid": "^8.3.2",
    "winston": "^3.7.2"
  },
  "description": "BlockedTODO GitHub Action app",
  "devDependencies": {
    "@babel/eslint-parser": "^7.17.0",
    "eslint": "^8.15.0",
    "jest": "^28.1.0"
  },
  "homepage": "https://github.com/DominicRoyStang/BlockedTODO#readme",
  "keywords": [
    "blocked",
    "todo",
    "blockedtodo",
    "github",
    "github-actions",
    "technical-debt"
  ],
  "license": "MIT",
  "type": "module",
  "name": "app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DominicRoyStang/BlockedTODO.git"
  },
  "scripts": {
    "db:download": "node scripts/download-database.js",
    "db:setup": "node scripts/setup-database.js",
    "db:migrate": "knex migrate:latest --knexfile=src/db/config/knexfile.js",
    "db:rollback": "knex migrate:rollback --knexfile=src/db/config/knexfile.js",
    "lint": "eslint './**/*.js'",
    "repl": "node ./repl.js",
    "scan": "node src/scan.js",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules npm run db:migrate && NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules npm run db:migrate && NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watchAll"
  },
  "version": "1.0.0"
}
