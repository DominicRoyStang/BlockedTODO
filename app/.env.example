# Copy to .env and fill in values for local development.
# In GitHub Actions, GITHUB_TOKEN and GITHUB_REPOSITORY are provided automatically.

# NODE_ENV='development'
# LOG_LEVEL='info'
# DATABASE_FILE='./database.db'

# GitHub personal access token with issues:write and actions:write
GITHUB_TOKEN=''

# Repository to scan and create notification issues on (owner/repo)
GITHUB_REPOSITORY='DominicRoyStang/BlockedTODO'

# Path to the codebase to scan
# SCAN_DIR='.'
